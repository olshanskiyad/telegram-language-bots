# Токен бота: создайте бота у @BotFather в Telegram и вставьте токен сюда (обязательно)
THAI_BOT_TOKEN=123456789:your_bot_token

# Ваш Telegram id (число, например его показывает @userinfobot). Владелец видит команду /users со статистикой
# учеников и получает сообщения учеников из кнопки «Написать». Если не задан, владельцем станет ПЕРВЫЙ, кто
# напишет боту. Для бота, которым пользуется кто-то кроме вас, задайте id заранее.
# OWNER_ID=123456789

# Отображаемое имя бота (видно в поиске Telegram). Не задано: имя из BotFather не трогаем.
# BOT_NAME="Thai tutor"

# Папки с данными (course.json, озвучка, база прогресса) и логами. Не заданы: ./data и ./logs рядом
# с кодом бота (в Docker это /app/data и /app/logs).
# THAI_DATA=./data
# THAI_LOG=./logs
# Часовой пояс отметок времени в истории ответов, по умолчанию UTC (например, Europe/Moscow)
# THAI_TZ=UTC

# Путь к базе прогресса учеников (SQLite). Не задан: THAI_DATA/bot.db
# THAI_DB=
