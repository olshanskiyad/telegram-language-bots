# Токен бота: создайте бота у @BotFather в Telegram и вставьте токен сюда (обязательно)
JP_BOT_TOKEN=123456789:your_bot_token

# Ваш Telegram id (число, например его показывает @userinfobot). Владелец видит команду /users со статистикой
# учеников и получает сообщения учеников из кнопки «Написать». Если не задан, владельцем станет ПЕРВЫЙ, кто
# напишет боту. Для бота, которым пользуется кто-то кроме вас, задайте id заранее.
# OWNER_ID=123456789

# Отображаемое имя бота (видно в поиске Telegram). Не задано: имя из BotFather не трогаем.
# BOT_NAME="Japanese tutor"

# Папки с данными (bank.json, озвучка, картинки, база прогресса) и логами. Не заданы: ./data и ./logs рядом
# с кодом бота (в Docker это /app/data и /app/logs).
# JP_DATA=./data
# JP_LOG=./logs

# Путь к базе прогресса учеников (SQLite). Не задан: JP_DATA/bot.db
# JP_DB=

# Только для сборки (build.py): шрифт картинок азбуки Klee One (его скачивает fetch_data.py) и шрифт с кириллицей
# для подписей чтения русскими буквами (по умолчанию DejaVu Sans из пакета fonts-dejavu-core).
# JP_FONT=
# JP_RU_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
